# ---------------------------------------------------------------------------
# Core / CLI
# ---------------------------------------------------------------------------
pacman_cli:
  - name: "bat"
  - name: "bmon"
  - name: "btop"
  - name: "htop"
  - name: "mc"
  - name: "tree"
  - name: "tmux"
  - name: "zsh"
  - name: "rlwrap"
  - name: "lynx"
  - name: "hexedit"
  - name: "jq"
  - name: "uv"
  - name: "zip"
  - name: "p7zip"

# ---------------------------------------------------------------------------
# Development
# ---------------------------------------------------------------------------
pacman_dev:
  - name: "cargo"
  - name: "npm"
  - name: "python-argcomplete"
  - name: "python-pdftotext"
  - name: "python-virtualenv"
  - name: "patchelf"
  - name: "expect"

# ---------------------------------------------------------------------------
# Git / Version Control
# ---------------------------------------------------------------------------
pacman_git:
  - name: "git-crypt"
  - name: "gitg"
  - name: "myrepos"
  - name: "tig"

# ---------------------------------------------------------------------------
# Security / Identity
# ---------------------------------------------------------------------------
pacman_security:
  - name: "apparmor"
  - name: "firejail"
  - name: "firetools"
  - name: "gcr"
  - name: "libfido2"
  - name: "lynis"
  - name: "nmap"
  - name: "pass"
  - name: "pinentry"
  - name: "qtpass"
  - name: "sops"
  - name: "yubikey-manager"

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------
pacman_network:
  - name: "arp-scan"
  - name: "ipset"
  - name: "net-tools"
  - name: "speedtest-cli"
  - name: "wireguard-tools"

# ---------------------------------------------------------------------------
# Docker / Containers
# ---------------------------------------------------------------------------
pacman_docker:
  - name: "docker"
  - name: "docker-buildx"
  - name: "docker-compose"
  - name: "dive"
  - name: "lxc"
  - name: "lxd"

# ---------------------------------------------------------------------------
# Virtualization
# ---------------------------------------------------------------------------
pacman_vm:
  - name: "dnsmasq"
  - name: "ebtables"
  - name: "edk2-ovmf"
  - name: "guestfs-tools"
  - name: "libguestfs"
  - name: "libvirt"
  - name: "openbsd-netcat"
  - name: "qemu-full"
  - name: "qemu-user-static"
  - name: "vde2"
  - name: "virt-manager"
  - name: "virt-viewer"

# ---------------------------------------------------------------------------
# DevOps / Infrastructure
# ---------------------------------------------------------------------------
pacman_devops:
  - name: "packer"
  - name: "terraform"
  - name: "vault"
  - name: "yamlfmt"
  - name: "yamllint"

# ---------------------------------------------------------------------------
# Backup / Synchronization
# ---------------------------------------------------------------------------
pacman_backup:
  - name: "duplicity"
  - name: "rclone"
  - name: "restic"
  - name: "syncthing"

# ---------------------------------------------------------------------------
# Storage / Disk / Filesystem
# ---------------------------------------------------------------------------
pacman_storage:
  - name: "gparted"
  - name: "veracrypt"

# ---------------------------------------------------------------------------
# Desktop / GUI
# ---------------------------------------------------------------------------
pacman_desktop:
  - name: "akm"
  - name: "baobab"
  - name: "discover"
  - name: "geany"
  - name: "libreoffice"
  - name: "rpi-imager"
  - name: "skanpage"
  - name: "terminator"
  - name: "tilda"
  - name: "transmission-gtk"

# ---------------------------------------------------------------------------
# Media
# ---------------------------------------------------------------------------
pacman_media:
  - name: "cmus"
  - name: "mpc"
  - name: "mpd"

# ---------------------------------------------------------------------------
# System / Hardware
# ---------------------------------------------------------------------------
pacman_system:
  - name: "earlyoom"
  - name: "exiftool"
  - name: "inotify-tools"
  - name: "lshw"
  - name: "perl-image-exiftool"
  - name: "bc"
  - name: "cdrtools"
  - name: "stow"
  - name: "ttf-agave-nerd"
  - name: "ttf-dejavu"
  - name: "wl-clipboard"
  - name: "tui-journal"
  - name: "flatpak"

# ---------------------------------------------------------------------------
# Packages
# ---------------------------------------------------------------------------
pacman_packages: >-
  {{
    pacman_cli
    | union(pacman_dev)
    | union(pacman_git)
    | union(pacman_security)
    | union(pacman_network)
    | union(pacman_docker)
    | union(pacman_vm)
    | union(pacman_devops)
    | union(pacman_backup)
    | union(pacman_storage)
    | union(pacman_desktop)
    | union(pacman_media)
    | union(pacman_system)
  }}
